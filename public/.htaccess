# Västerås Future Innovators 2026 — static SPA hosting rules (Apache / LiteSpeed)

# ── Block directory listing ──
Options -Indexes

# ── Old address: ssrl.iniac.se moved to vfi.iniac.se (keeps shared links & QR codes working) ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^ssrl\.iniac\.se$ [NC]
  RewriteRule ^ https://vfi.iniac.se%{REQUEST_URI} [L,R=301]
</IfModule>

# ── indiskbarnklubb.se: canonical host + root opens the IBK page ──
# Every rule is gated on the host, so vfi.iniac.se never matches and falls
# through to the SPA fallback below. `^$` matches only the bare root, so
# /ibk, /ibk-assets/*, /assets/* (CSS/JS) and all other paths are never caught.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www root -> https://indiskbarnklubb.se/ibk
  RewriteCond %{HTTP_HOST} ^www\.indiskbarnklubb\.se$ [NC]
  RewriteRule ^$ https://indiskbarnklubb.se/ibk [L,R=301]

  # www any other path -> same path on the bare domain
  RewriteCond %{HTTP_HOST} ^www\.indiskbarnklubb\.se$ [NC]
  RewriteRule ^(.*)$ https://indiskbarnklubb.se/$1 [L,R=301]

  # bare-domain root -> /ibk
  RewriteCond %{HTTP_HOST} ^indiskbarnklubb\.se$ [NC]
  RewriteRule ^$ https://indiskbarnklubb.se/ibk [L,R=301]
</IfModule>

# ── vxo.iniac.se: YNG RoboHack Växjö; the root opens /vxo ──
# Host-gated like the IBK rules. 302 (not 301) so browsers don't cache it forever
# in case the subdomain's landing page changes later.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^vxo\.iniac\.se$ [NC]
  RewriteRule ^$ https://vxo.iniac.se/vxo [L,R=302]
</IfModule>

# ── Force HTTPS ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── SPA fallback: serve index.html for any path that isn't a real file/dir ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # /ibk is an app page; serve it even if an old ibk/ asset folder is left on the server
  RewriteRule ^ibk/?$ /index.html [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ /index.html [L]
</IfModule>

# ── Gzip / Deflate compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache headers ──
<IfModule mod_expires.c>
  ExpiresActive On

  # index.html must always be revalidated so deploys are picked up
  <FilesMatch "^index\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>

  # hashed build assets (Vite fingerprints filenames) — cache for a year
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
